-- luacov configuration for VEAF Mission Creation Tools
-- Coverage is collected only for modules under src/scripts/veaf/.
-- Pattern matching uses Lua string.find on absolute file paths.
return {
    include = { "veaf" },
    -- dcsUnits is a generated data table (13 600 lines of literals, no logic). A test that merely
    -- `dofile`s it would count every line as covered and inflate the total by ~8 points, which would
    -- then be baked into the ratchet floor and collapse the moment that dofile went away.
    exclude = { "veaf_loader", "dcsUnits" },
    statsfile = "luacov.stats.out",
    reportfile = "luacov.report.out",
}
