# VEAF support bot — every variable the service reads.
#
# Copy to `.env`, fill in the real values, and keep that file out of git (it already is, see
# `.gitignore`). No value below is a real credential.
#
#   docker run --env-file services/support-bot/.env ...
#   or export them in the unit / shell that launches the service directly.

# --- required -------------------------------------------------------------------------------
# Discord bot token, from https://discord.com/developers/applications → Bot → Reset Token.
# SECRET. Anyone holding it *is* the bot.
SUPPORT_BOT_DISCORD_TOKEN=put-the-bot-token-here

# The single guild the bot serves. The lot's decision is a VEAF bot, not a bot invitable anywhere,
# and this is where that is expressed. Discord → right-click the server → Copy Server ID
# (Developer Mode must be on).
SUPPORT_BOT_DISCORD_GUILD_ID=000000000000000000

# What proves the bot to the documentation chatbot Worker, sent as `X-VEAF-Auth`. It must be the
# same value as the Worker's own `DISCORD_CLIENT_SECRET` Secret:
#   npx wrangler secret put DISCORD_CLIENT_SECRET   (from poc/doc-chatbot/worker/)
# SECRET. Required, and required on BOTH sides: the Worker refuses the `discord` client mode
# outright while its Secret is unset, so a bot started without this pair answers every question
# with "my configuration is incomplete" instead of failing at startup where it belongs.
SUPPORT_BOT_WORKER_SECRET=put-the-shared-worker-secret-here

# --- optional, shown with their defaults ------------------------------------------------------
# The documentation chatbot Worker. The default is production; override it to test against a
# preview deployment.
#SUPPORT_BOT_WORKER_ENDPOINT=https://veaf-docs-chatbot.veaf.workers.dev/chat

# Sent as `X-VEAF-Client`, so the Worker can quota Discord apart from the CLI and the website.
#SUPPORT_BOT_WORKER_CLIENT=discord

# Health endpoint. 127.0.0.1 by default because it is an operator interface; the container image
# sets 0.0.0.0, because a container's loopback is unreachable from the host.
# Port 0 asks the OS for an ephemeral one — usable, but then `--healthcheck` and the container
# HEALTHCHECK have no number to dial and always report a failure.
#SUPPORT_BOT_HEALTH_HOST=127.0.0.1
#SUPPORT_BOT_HEALTH_PORT=8081

# Logging. `json` is what a log collector parses; `text` is readable in a terminal.
#SUPPORT_BOT_LOG_LEVEL=INFO
#SUPPORT_BOT_LOG_FORMAT=json

# Seconds between heartbeat log lines — the signal a log-based alert watches for.
#SUPPORT_BOT_HEARTBEAT_SECONDS=60

# Seconds granted to work already in flight when a shutdown starts, before it is cancelled.
#SUPPORT_BOT_SHUTDOWN_GRACE_SECONDS=10

# --- quotas -----------------------------------------------------------------------------------
# Where the per-user counters are kept. Relative to the working directory. It must be WRITABLE and
# it must SURVIVE a restart: when the file cannot be read or written, the bot drops to a much
# stricter ceiling (2 questions per window for everyone) rather than serving on counters nobody
# keeps. In a container, mount a volume at /app/state.
#SUPPORT_BOT_QUOTA_STATE_FILE=state/quota.json

# Per-user burst guard: how many questions, over how many seconds.
#SUPPORT_BOT_QUOTA_USER_WINDOW_SECONDS=60
#SUPPORT_BOT_QUOTA_USER_PER_WINDOW=3

# What one Discord user may ask in a UTC day.
#SUPPORT_BOT_QUOTA_USER_PER_DAY=15

# What the WHOLE bot may ask in a UTC day. The Worker counts per user and cannot see the bot's
# total, so this is the only bound on it — and the free Gemini tier behind it is shared with the
# documentation website and the `veaf-tools ask` command line. Raise it deliberately.
#SUPPORT_BOT_QUOTA_GLOBAL_PER_DAY=200

# Start everything except the connection to the outside world. Used by the container smoke test.
# Leaving this on in production is loudly reported in every heartbeat line.
#SUPPORT_BOT_DRY_RUN=false
